{
  "name": "jev-release-oracle",
  "version": "0.1.0",
  "description": "Gate release risk from commits, tests, vulns, and incidents. Jev returns proceed, warn, hold, or review.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "all": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "keywords": [
    "github-actions",
    "jev",
    "release",
    "risk",
    "ci-cd",
    "jevforge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JevForge/jev-release-oracle.git"
  },
  "bugs": {
    "url": "https://github.com/JevForge/jev-release-oracle/issues"
  },
  "homepage": "https://github.com/JevForge/jev-release-oracle#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "ai": "^7.0.113",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.9",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
